# このファイルを .env.local にコピーして使う(.env* は .gitignore 済み)。
#   cp .env.example .env.local

# ローカル DB(docker compose up -d で起動)への接続
DATABASE_URL=postgres://postgres:postgres@localhost:55432/washokumap

# 予約通知(メール)。3つすべて設定すると Resend で送信、未設定ならログ出力にフォールバック。
# 店舗デスク宛(新規リクエスト)に加え、お客様宛(確定/お断り/代替提案/キャンセル)も
# RESEND_API_KEY と NOTIFICATION_FROM_EMAIL があれば送信する。
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFICATION_FROM_EMAIL=reservations@your-domain.com
# RESERVATION_DESK_EMAIL=desk@your-domain.com

# 公開URL(本番のオリジン)。設定するとお客様宛メールに予約状況ページ
# (代替案の承諾/お断りができる)へのリンクを載せる。未設定なら省略。
# APP_BASE_URL=https://washokumap.example.com

# 翻訳(DeepL)。未設定なら要望の日本語訳は付かない(原文のみ店舗へ伝達)。
# 無料キーは末尾が ":fx"。DEEPL_API_URL は省略可(プロキシ/テスト用の上書き)。
# DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# 管理(店舗投入)API の保護トークン。x-admin-token ヘッダ一致で許可。
# 未設定だと管理APIは常に拒否される(開発環境でも設定が必要)。
ADMIN_TOKEN=change-me

# サイト全体の限定公開。true にすると全ページ/APIがブラウザの Basic 認証で保護され、
# パスワードに ADMIN_TOKEN を入力すると閲覧できる(ユーザー名は任意・空でも可)。
# /mayuchan 配下と /api/mayuchan/* は対象外(x-admin-token による独自保護があるため)。
# x-admin-token ヘッダ付きのリクエスト(cron 等の自動処理)もそのまま通る。
# SITE_LOCK=true

# 公開APIのレート制限(IP単位・インメモリ)。テスト等で無効化したいときだけ true。
# 既定は有効。水平分割時は共有ストア(Redis等)への置換を検討。
# RATE_LIMIT_DISABLED=true

# 前段の信頼できるリバースプロキシ(Render/Vercel/nginx等)の IP/CIDR をカンマ区切りで指定。
# X-Forwarded-For はこの設定がある場合のみ信頼する(右=直近ホップから辿り、
# 信頼プロキシ以外の最初のIPをクライアントIPとする)。
# 未設定時は XFF を無視: レート制限は全クライアント共有バケット、監査ログのIPは記録なし。
# 例: TRUSTED_PROXY_IPS=10.0.0.0/8,100.20.92.101,::1
# TRUSTED_PROXY_IPS=

# ジオコーディング(住所→緯度経度)。既定はキーレスの Nominatim(OSM)。
# GEOCODE_API_URL=https://nominatim.openstreetmap.org/search

# 口コミ写真などのアップロード保存先バックエンド。local(既定)| supabase。
# どちらでも配信は /api/uploads/<name> のまま変わらない。
# - local:    ローカルFSの UPLOAD_DIR(既定 ./uploads)に保存。開発・永続ディスク環境向け。
# - supabase: Supabase Storage に保存。Render 等の揮発FS環境向け。下の SUPABASE_* が必須。
# UPLOAD_STORAGE=local
# UPLOAD_DIR=./uploads

# UPLOAD_STORAGE=supabase 用の接続情報。
# SUPABASE_URL はダッシュボードの Settings → API の Project URL。
# SUPABASE_SERVICE_ROLE_KEY は同じ画面の service_role キー(**公開厳禁**。anon キーではない)。
# バケットはダッシュボードの Storage で private として事前に作成しておく(既定名 uploads)。
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxx...
# SUPABASE_STORAGE_BUCKET=uploads

# アップロード保存先全体の容量上限(バイト)。ディスク/ストレージ圧迫DoSの防止弁。
# local/supabase 両バックエンドに効く。既定は 2GiB(2147483648)。0 で無制限。
# 上限到達時は 507 を返し保存しない。Supabase 無料枠(1GB)なら 900000000 程度を推奨。
# UPLOAD_DIR_MAX_BYTES=2147483648
